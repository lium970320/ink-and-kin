# ─── 必填 ───────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:password@localhost:5432/ink_and_kin
# 生产环境必填。生成随机密钥：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# ─── AI 提供商（至少配置一个）─────────────────────────────────────────────────
# 推荐从「设置 → AI 设置」为自己的账号配置。受信任的单用户实例也可使用下面的进程密钥。
LLM_ALLOW_SERVER_FALLBACK=false
# 自定义 API 或中转站的受信任来源，逗号分隔。填协议、域名/IP 和端口，例如 https://api.example.com
LLM_ALLOWED_ORIGINS=
DEFAULT_LLM_PROVIDER=openai

# 原文库搜索。缺省使用本地 BM25。显式配置启用后，原文库手动搜索可把
# 检索词和所选作品片段发送给配置的向量/重排服务。
EMBEDDING_ENABLED=false
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=0
EMBEDDING_TIMEOUT_MS=12000
RERANK_ENABLED=false
RERANK_API_KEY=
RERANK_BASE_URL=
RERANK_MODEL=bge-reranker-v2-m3
RERANK_TIMEOUT_MS=8000

# 对话工具允许模型请求日期、角色资料内明确配置的城市天气和当前账号的记忆。
COMPANION_TOOLS_ENABLED=false
COMPANION_WEATHER_TIMEOUT_MS=5000

# 已通过签名认证的 QQ 私聊事件。开启图片识别会把最多四张来自 QQ 的图片
# 发送给当前角色使用的视觉模型。开启分句打断可撤回本轮已确认发出的部分回复。
QQ_INPUT_STATUS_ENABLED=true
QQ_RECALL_AWARENESS_ENABLED=true
QQ_FORWARD_UNPACK_ENABLED=true
QQ_POKE_REPLY_ENABLED=false
QQ_INBOUND_IMAGES_ENABLED=false
QQ_TURN_INTERRUPT_RECALL_ENABLED=false

# OpenAI
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o

# Atlas Cloud (OpenAI-compatible; requests are submitted once without automatic retries)
ATLASCLOUD_API_KEY=
ATLAS_BASE_URL=https://api.atlascloud.ai/v1
ATLAS_MODEL=google/gemini-3-flash-preview

# Cheaper Inference (OpenAI-compatible)
CHEAPER_INFERENCE_API_KEY=
CHEAPER_INFERENCE_BASE_URL=https://api.cheaperinference.com/v1
CHEAPER_INFERENCE_MODEL=gpt-5.4-mini

# DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# Kimi (Moonshot)
KIMI_API_KEY=
KIMI_BASE_URL=https://api.moonshot.cn/v1
KIMI_MODEL=moonshot-v1-8k

# Claude
CLAUDE_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-6
CLAUDE_BASE_URL=https://api.anthropic.com

# Ollama (本地)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# Dify
DIFY_API_KEY=
DIFY_URL=

# 讯飞星火
XUNFEI_APP_ID=
XUNFEI_API_KEY=
XUNFEI_API_SECRET=
XUNFEI_MODEL_VERSION=v3.5

# 通义千问
TONGYI_API_KEY=
TONGYI_URL=
TONGYI_MODEL=qwen-turbo

# 豆包
DOUBAO_API_KEY=
DOUBAO_BASE_URL=
DOUBAO_MODEL=

# 302AI
_302AI_API_KEY=

# ─── 微信机器人（可选）──────────────────────────────────────────────────────
# 微信官方 ClawBot 通道（腾讯 iLink 协议）。需微信 8.0.70+ 且「我→设置→插件」中有「微信 ClawBot」入口。
WECHAT_ENABLED=false
# 扫码登录使用的 bot_type（对齐官方插件默认值）
WECHAT_BOT_TYPE=3
# 腾讯 iLink API 地址（一般无需修改）
WECHAT_ILINK_BASE_URL=https://ilinkai.weixin.qq.com
WECHAT_ILINK_CDN_URL=https://novac2c.cdn.weixin.qq.com/c2c
# iLink 应用标识
WECHAT_ILINK_APP_ID=bot
# 可选的部署路由标签
WECHAT_ROUTE_TAG=
# 应用版本号，会作为 channel_version 上报给 iLink 后端
APP_VERSION=1.0.0

# ─── 其他 ───────────────────────────────────────────────────────────────────
UPLOAD_DIR=./uploads
PYTHON_PATH=python3
SKILL_ENGINE_DIR=./skill-engine
APP_HOST=127.0.0.1
PORT=3000
# AI 身份透明：true（默认）= 被认真询问时承认是 AI；false = 完全沉浸模式
PERSONA_AI_TRANSPARENCY=true
# 情绪判定引擎：llm（默认，模型阅读对话后判断情绪）/ heuristic（纯关键词规则，零额外 LLM 调用）
EMOTION_ENGINE=llm

# ─── 安全 ───────────────────────────────────────────────────────────────────
# 允许发起写操作的其他来源（逗号分隔）。同源始终允许；仅在把书中人嵌入到
# 另一个站点时才需要填写。
ALLOWED_ORIGINS=
# 会话 Cookie 的 SameSite 策略：lax（默认，推荐）/ none / strict。
# "none" 需要 HTTPS，且必须配合上面的 Origin 校验使用。
COOKIE_SAMESITE=lax
# 注册默认关闭。需要手动创建受信任账号时，可在本机临时打开。
ALLOW_REGISTRATION=false
# auto 在空库中生成首个账号和随机密码；manual 可配合临时开放注册使用。
MIRRAI_BOOTSTRAP_ADMIN=auto
# 首次运行凭据与数据文件的存放目录。桌面版会自动设置；留空则使用 UPLOAD_DIR 的上级目录。
MIRRAI_DATA_ROOT=
# 危机支持资源清单的覆盖文件（JSON）。留空则使用内置清单。
SAFETY_RESOURCES_FILE=

# ─── 主动提醒 ───────────────────────────────────────────────────────────────
# 免打扰时段，格式 "HH:MM-HH:MM"。跨越午夜时会覆盖夜里和清晨。
REMINDER_QUIET_HOURS=23:00-08:00

# 场景配图：管理员允许访问的 ComfyUI 完整源，逗号分隔；默认拒绝。见 BATCH8B.md。
# 示例：http://127.0.0.1:8188；账号页面不能扩大此列表。
MIRRAI_COMFYUI_ALLOWED_ORIGINS=
